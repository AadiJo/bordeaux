{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposalId",
    "status",
    "recommendedCandidateId",
    "recommendedCandidateValid",
    "requiredPortalIds",
    "metrics",
    "assessment"
  ],
  "properties": {
    "proposalId": {
      "type": ["string", "null"]
    },
    "status": {
      "type": "string"
    },
    "recommendedCandidateId": {
      "type": ["string", "null"]
    },
    "recommendedCandidateValid": {
      "type": ["boolean", "null"]
    },
    "requiredPortalIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalTimeS",
        "totalDistanceM",
        "estimatedCollectionAreaM2",
        "minimumClearanceM"
      ],
      "properties": {
        "totalTimeS": {
          "type": ["number", "null"]
        },
        "totalDistanceM": {
          "type": ["number", "null"]
        },
        "estimatedCollectionAreaM2": {
          "type": ["number", "null"]
        },
        "minimumClearanceM": {
          "type": ["number", "null"]
        }
      }
    },
    "assessment": {
      "type": "string"
    }
  }
}
